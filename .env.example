# Copy to .env and adjust as needed. Never commit the real .env file.

# Directory where trained model/scaler artifacts are stored.
MNIST_MODEL_DIR=./models

# Directory where evaluation reports and figures are written.
MNIST_REPORTS_DIR=./reports

# Python logging level: DEBUG, INFO, WARNING, ERROR.
MNIST_LOG_LEVEL=INFO

# Random seed used for data splitting and model training.
MNIST_RANDOM_SEED=42

# Set to 1 to request a public Gradio share link (tunnels your local
# server publicly — only enable this deliberately).
GRADIO_SHARE=0

# Port the Gradio demo listens on.
GRADIO_SERVER_PORT=7860

# Bind address for the Gradio server. Keep "127.0.0.1" (loopback-only) for
# local development. The Docker image overrides this to "0.0.0.0" so the
# server is reachable from outside the container.
GRADIO_SERVER_NAME=127.0.0.1
